{
  "name": "sonicmatter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dsp": "faust2wasm-ts src/audio/models/string.dsp src/audio/models/generated/string -no-template && faust2wasm-ts src/audio/models/bar.dsp src/audio/models/generated/bar -no-template && faust2wasm-ts src/audio/models/glass.dsp src/audio/models/generated/glass -no-template",
    "predev": "npm run dsp",
    "prebuild": "npm run dsp",
    "pretest": "npm run dsp",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "compare": "node analysis/compare.ts",
    "render:bar": "node analysis/render-bar.ts",
    "render:glass": "node analysis/render-glass.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@grame/faustwasm": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
