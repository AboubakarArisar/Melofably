{
  "name": "sonicmatter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dsp": "node scripts/build-dsp.mjs",
    "engine": "asc assembly/engine.ts --outFile src/experimental/wasm/generated/engine.wasm --runtime stub -O3 --noAssert --use abort=",
    "predev": "npm run dsp && npm run engine",
    "prebuild": "npm run dsp && npm run engine",
    "pretest": "npm run dsp && npm run engine",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "baseline": "node analysis/baseline.ts",
    "compare": "node analysis/compare.ts",
    "render:bar": "node analysis/render-bar.ts",
    "render:glass": "node analysis/render-glass.ts",
    "render:wood": "node analysis/render-wood.ts",
    "render:experimental": "node analysis/render-experimental.ts",
    "render:wasm": "node analysis/render-wasm.ts",
    "render:builder": "node analysis/render-builder.ts",
    "render:string": "node analysis/render-string.ts",
    "render:soundboard": "node analysis/render-soundboard.ts",
    "render:soundboard-refined": "node analysis/render-soundboard-refined.ts",
    "render:soundboard-enclosed": "node analysis/render-soundboard-enclosed.ts",
    "render:soundboard-damped": "node analysis/render-soundboard-damped.ts",
    "render:string-body": "node analysis/render-string-body.ts",
    "render:string-playing": "node analysis/render-string-playing.ts",
    "render:string-bar": "node analysis/render-string-bar.ts",
    "render:radiation": "node analysis/render-radiation.ts",
    "render:radiator": "node analysis/render-radiator.ts",
    "render:hybrid-study": "node analysis/render-hybrid-study.ts",
    "render:tuned-example": "node analysis/render-tuned-example.ts",
    "render:three-body": "node analysis/render-three-body.ts",
    "render:three-body-mounting": "node analysis/render-three-body-mounting.ts",
    "render:three-body-pads": "node analysis/render-three-body-pads.ts",
    "bench:wasm": "node analysis/bench-wasm.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@grame/faustwasm": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "assemblyscript": "^0.28.20",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
